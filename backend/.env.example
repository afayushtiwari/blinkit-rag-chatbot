# Gemini is used only for BlinkBot chat generation
GOOGLE_API_KEY=your_gemini_api_key

# Optional invoice email (SMTP)
# Keep EMAIL_ENABLED=false until you have configured an SMTP provider.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-smtp-app-password
SMTP_FROM=QuickCart <your-email@example.com>
SMTP_USE_TLS=true
