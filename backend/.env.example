# Blinkit RAG Chatbot - Environment Variables
# Copy this file to .env and fill in your values.

# Google Gemini API Key (required for RAG chatbot)
# Get a free key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Gemini model used for the agentic chatbot (must support function calling)
# Example: gemini-3.5-flash-lite, gemini-2.0-flash, gemini-1.5-flash
LLM_MODEL=gemini-3.5-flash-lite

# Frontend URL for CORS (comma-separated for multiple origins)
# Example: http://localhost:3000,https://your-vercel-domain.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# Rate limit: requests per minute per IP (default: 30)
RATE_LIMIT_PER_MINUTE=30

# Embedding backend: "onnx" (default, lightweight, ~fits Render's free 512 MB)
# or "transformers" (PyTorch; matches the original eval numbers exactly).
EMBEDDING_BACKEND=onnx
